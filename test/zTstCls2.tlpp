#include "tlpp-core.th"

/*/{Protheus.doc} zTstCls2
Classe TLPP do E2E de depuracao do tds-mcp: propriedades lidas dentro de
metodo (::prop e self:prop). Inofensiva; nao grava nada.
@type class
@author tds-mcp
@since 06/10/2026
/*/
Class zTstCls2
    Public Data nValor
    Public Data cNome

    Public Method New()
    Public Method Somar(nQtd)
    Public Method Dobro()
EndClass

/*/{Protheus.doc} New
Cria o objeto com valores conhecidos.
@type method
@author tds-mcp
@since 06/10/2026
@return object, a instancia
/*/
Method New() Class zTstCls2
    ::nValor := 20
    ::cNome  := "objeto tlpp"
Return Self

/*/{Protheus.doc} Somar
Soma nQtd a nValor.
@type method
@author tds-mcp
@since 06/10/2026
@param nQtd, numeric, quantidade a somar
@return numeric, nValor depois da soma
/*/
Method Somar(nQtd) Class zTstCls2
    Local nAntes := ::nValor

    ::nValor := nAntes + nQtd
Return ::nValor

/*/{Protheus.doc} Dobro
Dobro de nValor, sem alterar o objeto.
@type method
@author tds-mcp
@since 06/10/2026
@return numeric, nValor * 2
/*/
Method Dobro() Class zTstCls2
Return ::nValor * 2

/*/{Protheus.doc} U_zTstCls2
Cria o objeto e chama Somar(5).
@type function
@author tds-mcp
@since 06/10/2026
@return numeric, 25
/*/
User Function zTstCls2()
    Local oObj := zTstCls2():New()
    Local nRes := oObj:Somar(5)
Return nRes
